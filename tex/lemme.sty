% Style commun des PDF de Lemme (compiler avec xelatex).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lemme}[2026/10/29 Lemme]

\RequirePackage[a4paper,left=2.4cm,right=2.4cm,top=2.8cm,bottom=2.6cm,headsep=1cm]{geometry}
\RequirePackage{amsmath,mathtools}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{Latin Modern Roman}
\setsansfont{Inter}[UprightFont=* Regular,BoldFont=* SemiBold,ItalicFont=* Italic]
\newfontfamily\heavyfont{Inter}[UprightFont=* Bold]
\setmonofont{Latin Modern Mono}
\setmathfont{Latin Modern Math}
\RequirePackage{polyglossia}
\setmainlanguage{french}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\definecolor{navy}{HTML}{0F2557}
\definecolor{gold}{HTML}{FFC93C}
\definecolor{goldsoft}{HTML}{FFF4CF}
\definecolor{ink}{HTML}{101935}
\definecolor{muted}{HTML}{586283}
\definecolor{line}{HTML}{DCE2EF}
\color{ink}
\RequirePackage{enumitem}
\setlist[itemize]{label={\raisebox{0.18ex}{\color{gold}\rule{0.5em}{0.5em}}},leftmargin=1.5em,itemsep=0.55em,topsep=0.6em}
\setlist[enumerate]{label={\sffamily\bfseries\color{navy}\arabic*.},leftmargin=1.8em,itemsep=0.55em,topsep=0.6em}
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\small,backgroundcolor=\color{goldsoft!40},frame=none,xleftmargin=0.8em,framexleftmargin=0.6em,aboveskip=0.9em,belowskip=0.9em,columns=fullflexible,keepspaces=true,showstringspaces=false}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks]{hyperref}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\linespread{1.08}

% Métadonnées
\newcommand\lemmesubject{}
\newcommand\lemmemeta{}
\newcommand\lemmeurl{}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\sffamily\small\heavyfont\color{navy}Lemme}
\fancyhead[R]{\sffamily\footnotesize\color{muted}\lemmemeta}
\fancyfoot[L]{\sffamily\footnotesize\color{muted}\lemmeurl}
\fancyfoot[R]{\sffamily\footnotesize\color{muted}\thepage\,/\,\pageref*{LastPage}}

% Titre de document
\newcommand\lemmetitle[2]{%
  {\sffamily\footnotesize\color{muted}\MakeUppercase{#1}\par}
  \vspace{0.35em}
  {\heavyfont\fontsize{24}{28}\selectfont\color{navy}#2\par}
  \vspace{0.7em}
  {\color{gold}\rule{2.6cm}{3pt}\par}
  \vspace{1.2em}
}
% Intertitre
\newcommand\lemmesection[1]{%
  \par\vspace{1.1em}{\sffamily\bfseries\large\color{navy}#1\par}\vspace{0.3em}}
% Encadré « au programme »
\newcommand\lemmenotions[1]{%
  {\sffamily\small\color{muted}#1\par}}
